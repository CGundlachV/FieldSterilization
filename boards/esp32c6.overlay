#include <freq.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	chosen {
		zephyr,display = &mydisplay;
	};

	aliases {
		sw0 = &run_button;
		heater0 = &heater_output;
	};

	buttons {
		compatible = "gpio-keys";
		debounce-interval-ms = <30>;

		run_button: button-0 {
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Run/stop button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	control_outputs {
		compatible = "gpio-leds";

		heater_output: heater-output {
			gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
			label = "Heater control output";
		};
	};

	mipi_dbi_display {
		compatible = "zephyr,mipi-dbi-spi";
		status = "okay";
		spi-dev = <&spi2>;
		dc-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		mydisplay: mydisplay@0 {
			compatible = "galaxycore,gc9x01x";
			reg = <0>;
			mipi-max-frequency = <DT_FREQ_M(32)>;
			width = <240>;
			height = <240>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
			display-inversion;
			orientation = "180";
			status = "okay";
		};
	};
};

&pinctrl {
	spim2_display: spim2_display {
		group1 {
			pinmux = <SPIM2_SCLK_GPIO19>;
		};

		group2 {
			pinmux = <SPIM2_MOSI_GPIO18>;
			output-low;
		};
	};
};

&spi2 {
	cs-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spim2_display>;
};

&rf_switch {
	status = "disabled";
};

/* Disable the hardware I2C peripheral — it has known issues on ESP32C6 with Zephyr */
&i2c0 {
	status = "disabled";
};

/* Software bitbang I2C on the same GPIO22/23 pins */
/ {
	i2c_sensor: i2c_sensor {
		compatible = "gpio-i2c";
		sda-gpios = <&gpio0 22 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		scl-gpios = <&gpio0 23 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
	};
};
